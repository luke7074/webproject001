<%- include('partials/header') %>
<div class="bg-white p-4 rounded-3 shadow-sm mx-auto" style="max-width: 700px;">
  <h4 class="fw-bold mb-3">매물 정보 수정</h4>
  <form action="/products/<%= product.product_id %>/edit" method="POST">
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label fw-bold">카테고리</label>
        <select name="category" class="form-select">
          <% ['노트북', '스마트폰', '태블릿', '주변기기'].forEach(cat => { %>
            <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label fw-bold">표준 모델명</label>
        <input type="text" name="model_name" class="form-control" value="<%= product.model_name %>" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label fw-bold">제목</label>
      <input type="text" name="title" class="form-control" value="<%= product.title %>" required>
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="form-label fw-bold">판매 가격 (원)</label>
        <input type="number" name="price" class="form-control" value="<%= product.price %>" required>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">상태 등급</label>
        <select name="condition_grade" class="form-select">
          <% ['S급', 'A급', 'B급'].forEach(g => { %>
            <option value="<%= g %>" <%= product.condition_grade === g ? 'selected' : '' %>><%= g %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label fw-bold">상세 설명</label>
      <textarea name="content" class="form-control" rows="5" required><%= product.content %></textarea>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">수정 완료</button>
  </form>
</div>
<%- include('partials/footer') %>
