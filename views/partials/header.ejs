<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RealPrice - IT·전자기기 실시간 시세 분석 직거래</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .brand-logo { font-weight: 800; letter-spacing: -0.5px; }
    .product-card { transition: transform 0.15s ease; }
    .product-card:hover { transform: translateY(-4px); box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
  </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
  <div class="container">
    <a class="navbar-brand brand-logo text-info" href="/">
      <i class="bi bi-graph-up-arrow me-1"></i>RealPrice
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/">직거래 장터</a></li>
        <li class="nav-item"><a class="nav-link text-warning fw-semibold" href="/prices"><i class="bi bi-bar-chart-fill me-1"></i>실시간 모델 시세표</a></li>
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/my-wishes"><i class="bi bi-heart-fill text-danger me-1"></i>내 찜목록</a></li>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2">
        <% if (user) { %>
          <span class="text-light small me-2"><strong><%= user.nickname %></strong> (<%= user.region %>)</span>
          <a href="/products/new" class="btn btn-info btn-sm fw-bold">+ 내 기기 팔기</a>
          <a href="/auth/logout" class="btn btn-outline-light btn-sm">로그아웃</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-light btn-sm">로그인</a>
          <a href="/auth/register" class="btn btn-info btn-sm fw-bold">회원가입</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<div class="container pb-5">
