<%- include('partials/header') %>
<div class="bg-white p-4 rounded-3 shadow-sm mx-auto" style="max-width: 420px;">
  <h4 class="fw-bold mb-3 text-center">RealPrice 회원가입</h4>
  <% if (error) { %><div class="alert alert-danger small"><%= error %></div><% } %>
  <form action="/auth/register" method="POST">
    <div class="mb-2">
      <label class="form-label">아이디</label>
      <input type="text" name="login_id" class="form-control" required>
    </div>
    <div class="mb-2">
      <label class="form-label">비밀번호</label>
      <input type="password" name="password" class="form-control" required>
    </div>
    <div class="mb-2">
      <label class="form-label">닉네임</label>
      <input type="text" name="nickname" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">직거래 선호 지역</label>
      <input type="text" name="region" class="form-control" placeholder="예: 인천 미추홀구" required>
    </div>
    <button type="submit" class="btn btn-info w-100 fw-bold">가입하기</button>
  </form>
</div>
<%- include('partials/footer') %>
